Branch(time,age,n,b,w,np,bp):
    component = generator.parameters["Branch"]
    if not component.CheckProduceComponent(time,age,n,b,w=w,np=np,bp=bp):
        produce *
    if (time + age) >= OUTPUT_TIME:
        produce Branch(time,age,n,b,w,np,bp)
    elif component.CheckProduceAge(time,age,n,b,w=w,np=np,bp=bp):
        if generator.verbose_lpy:
            print(f"Ageing Branch[{age},{n}]")
        ageinc = min(generator.AgeInc(),
                     OUTPUT_TIME - (time + age))
        produce Branch(time,age+ageinc,n,b,w,np,bp)
    plastochron = generator.BranchPlastocron()
    time = time + age
    if age >= plastochron:
        age = age - plastochron
    if generator.verbose_lpy:
        print(f"Node: {n} (t = {time})")
    nproduce /(generator.BranchRotationAngle(time,age,n,b,w=w,np=np,bp=bp))
    nproduce &(generator.BranchAngle(time,age,n,b,w=w,np=np,bp=bp))
    nproduce /(generator.BranchTiltAngle(time,age,n,b,w=w,np=np,bp=bp))
    nproduce Internode(time,age,n,b)
    nproduce [Node(time,age,n,b,w,np,bp)]
    if generator.verbose_lpy:
        print(f"Next Branch: {n + 1}")
    for binc in range(0 + 1, generator.BranchBMax()):
        nproduce [Branch(time,age,n+1,b+binc,w,np,bp)]
    binc = 0
    produce [Branch(time,age,n+1,b+binc,w,np,bp)]

homomorphism:
maximum depth: 11

Apex(time,age,n,b,w,np,bp):
    produce &(90)@o^(90)

Internode(time,age,n,b):
    component = generator.parameters["Internode"]
    with component.temporary_index(time,age,n,b):
        if not component.CheckProduceComponent(time,age,n,b):
            produce [/(0)]
        if generator.verbose_lpy:
            print(f"Homomorphism Internode[{age},{n}]")
        nproduce /(generator.InternodeRotationAngle(time,age,n,b))
        nproduce &(generator.InternodeAngle(time,age,n,b))
        nproduce /(generator.InternodeTiltAngle(time,age,n,b))
        nproduce SetColor(generator.InternodeColor(time,age,n,b))
        length = generator.InternodeLength(time,age,n,b)
        nproduce F(0.001 * length)
        xprev = 0.0
        for x in component.XIterator():
            DX = length * (x - xprev)
            xprev = x
            nproduce _(generator.InternodeWidth(time,age,n,b,x=x))
            nproduce &(generator.InternodeBend(time,age,n,b,x=x)*DX)
            nproduce /(generator.InternodeTwist(time,age,n,b,x=x)*DX)
            if x == 1:
                produce F(DX)
            else:
                nproduce F(DX)

CotyledonComplex(time,age,n,b,w):
    component = generator.parameters["CotyledonComplex"]
    with component.temporary_index(time,age,n,b,w=w):
        if not component.CheckProduceComponent(time,age,n,b,w=w):
            produce [/(0)]
        if generator.verbose_lpy:
            print(f"Homomorphism CotyledonComplex[{age},{n}]")
        nproduce /(generator.CotyledonComplexRotationAngle(time,age,n,b,w=w))
        nproduce &(generator.CotyledonComplexAngle(time,age,n,b,w=w))
        nproduce /(generator.CotyledonComplexTiltAngle(time,age,n,b,w=w))
        nproduce Petiole(time,age,n,b)
        for w in range(0, generator.CotyledonWMax()):
            nproduce [Cotyledon(time,age,n,b)]
        produce &(90)@o^(90)

Petiole(time,age,n,b):
    component = generator.parameters["Petiole"]
    with component.temporary_index(time,age,n,b):
        if not component.CheckProduceComponent(time,age,n,b):
            produce [/(0)]
        if generator.verbose_lpy:
            print(f"Homomorphism Petiole[{age},{n}]")
