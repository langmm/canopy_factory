
############################################################
## External parameters
############################################################

extern(RUNTIME_PARAM = {})
extern(OUTPUT_TIME = 27)
extern(DERIVATION_LENGTH = OUTPUT_TIME)

############################################################
## Python functions
############################################################

from canopy_factory.utils import get_class_registry
generator_cls = get_class_registry().get("crop", "tomato")
generator = generator_cls(context=context(), **RUNTIME_PARAM)
NMax = generator.NMax()
PLASTOCHRON = generator.Plastocron()
StartingAngle = generator.sample_dist("uniform", 0, 360)
if generator.verbose_lpy:
    print(f"OUTPUT_TIME = {OUTPUT_TIME}")
    print(f"DERIVATION_LENGTH = {DERIVATION_LENGTH}")
    print(f"PLASTOCHRON = {PLASTOCHRON}")


############################################################
## Begin LSystem syntax
############################################################

module A
module Apex
module Internode
module Node
module CotyledonComplex
module Petiole
module Cotyledon
module CompoundLeaf
module CompoundLeafApex
module CompoundLeafInternode
module CompoundLeafNode
module LeafletComplex
module LeafletPetiole
module Leaflet
module FruitCluster
module FruitClusterPedicel
module FruitClusterApex
module FruitClusterInternode
module FruitClusterNode
module FruitingComplex
module Pedicel
module Calyx
module Sepal
module Bud
module Flower
module Pistil
module Petal
module Fruit
module Branch

Axiom: @Gc/(StartingAngle)Apex(0,0,0,0,0,0,0)@Ge
derivation length: DERIVATION_LENGTH

production:

Apex(time,age,n,b,w,np,bp):
    component = generator.parameters["Apex"]
    if not component.CheckProduceComponent(time,age,n,b,w=w,np=np,bp=bp):
        produce *
    if (time + age) >= OUTPUT_TIME:
        produce Apex(time,age,n,b,w,np,bp)
    elif component.CheckProduceAge(time,age,n,b,w=w,np=np,bp=bp):
        if generator.verbose_lpy:
            print(f"Ageing Apex[{age},{n}]")
        ageinc = min(generator.AgeInc(),
                     OUTPUT_TIME - (time + age))
        produce Apex(time,age+ageinc,n,b,w,np,bp)
    plastochron = generator.ApexPlastocron()
    time = time + age
    if age >= plastochron:
        age = age - plastochron
    if generator.verbose_lpy:
        print(f"Node: {n} (t = {time})")
    nproduce /(generator.ApexRotationAngle(time,age,n,b,w=w,np=np,bp=bp))
    nproduce &(generator.ApexAngle(time,age,n,b,w=w,np=np,bp=bp))
    nproduce /(generator.ApexTiltAngle(time,age,n,b,w=w,np=np,bp=bp))
    nproduce Internode(time,age,n,b)
    nproduce [Node(time,age,n,b,w,np,bp)]
    if generator.verbose_lpy:
        print(f"Next Apex: {n + 1}")
    for binc in range(0 + 1, generator.BranchBMax()):
        nproduce [Branch(time,age,n+1,b+binc,w,np,bp)]
    binc = 0
    produce [Apex(time,age,n+1,b+binc,w,np,bp)]

Internode(time,age,n,b):
    component = generator.parameters["Internode"]
    if not component.CheckProduceComponent(time,age,n,b):
        produce *
    if (time + age) >= OUTPUT_TIME:
        produce Internode(time,age,n,b)
    else:
        if generator.verbose_lpy:
            print(f"Ageing Internode[{age},{n}]")
        ageinc = min(generator.AgeInc(),
                     OUTPUT_TIME - (time + age))
        produce Internode(time,age+ageinc,n,b)

Node(time,age,n,b,w,np,bp):
    nproduce /(generator.NodeRotationAngle(time,age,n,b,w=w,np=np,bp=bp))
    nproduce &(generator.NodeAngle(time,age,n,b,w=w,np=np,bp=bp))
    nproduce /(generator.NodeTiltAngle(time,age,n,b,w=w,np=np,bp=bp))
    for w in range(0, generator.CotyledonComplexWMax()):
        nproduce [CotyledonComplex(time,age,n,b,w)]
    for w in range(0, generator.CompoundLeafWMax()):
        nproduce [CompoundLeaf(time,age,n,b,w,np,bp)]
    for w in range(0, generator.FruitClusterWMax()):
        nproduce [FruitCluster(time,age,n,b,w,np,bp)]
    produce [/(0)]

