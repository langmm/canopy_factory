Branch(time,age,n,b):
    component = generator.parameters["Branch"]
    if not component.CheckProduceComponent(time,age,n,b):
        produce *
    if (time + age) >= OUTPUT_TIME:
        produce Branch(time,age,n,b)
    elif component.CheckProduceAge(time,age,n,b):
        if generator.verbose_lpy:
            print(f"Ageing Branch[{age},{n}]")
        ageinc = min(generator.AgeInc(),
                     OUTPUT_TIME - (time + age))
        produce Branch(time,age+ageinc,n,b)
    time = time + age
    if age >= PLASTOCHRON:
        age = age - PLASTOCHRON
    if generator.verbose_lpy:
        print(f"Node: {n} (t = {time})")
    nproduce /(generator.BranchRotationAngle(time,age,n,b))
    nproduce &(generator.BranchAngle(time,age,n,b))
    for w in range(0, generator.InternodeWMax()):
        nproduce Internode(time,age,n,b)
    nproduce [Node(time,age,n,b)]
    if generator.verbose_lpy:
        print(f"Next Branch: {n + 1}")
    for binc in range(0 + 1, generator.BranchBMax()):
        nproduce [Branch(time,age,n+1,b+binc)]
    binc = 0
    produce [Branch(time,age,n+1,b+binc)]

homomorphism:
maximum depth: 3

Apex(time,age,n,b):
    produce &(90)@o^(90)

Internode(time,age,n,b):
    component = generator.parameters["Internode"]
    with component.temporary_index(time,age,n,b):
        if not component.CheckProduceComponent(time,age,n,b):
            produce [/(0)]
        if generator.verbose_lpy:
            print(f"Homomorphism Internode[{age},{n}]")
        nproduce /(generator.InternodeRotationAngle(time,age,n,b))
        nproduce &(generator.InternodeAngle(time,age,n,b))
        nproduce SetColor(generator.InternodeColor(time,age,n,b))
        length = generator.InternodeLength(time,age,n,b)
        nproduce F(0.001 * length)
        xprev = 0.0
        for x in component.XIterator():
            DX = length * (x - xprev)
            xprev = x
            nproduce _(generator.InternodeWidth(time,age,n,b,x=x))
            nproduce &(generator.InternodeBend(time,age,n,b,x=x)*DX)
            nproduce /(generator.InternodeTwist(time,age,n,b,x=x)*DX)
            if x == 1:
                produce F(DX)
            else:
                nproduce F(DX)

Cotyledon(time,age,n,b,w):
    component = generator.parameters["Cotyledon"]
    with component.temporary_index(time,age,n,b,w=w):
        if not component.CheckProduceComponent(time,age,n,b,w=w):
            produce [/(0)]
        if generator.verbose_lpy:
            print(f"Homomorphism Cotyledon[{age},{n}]")
        nproduce /(generator.CotyledonRotationAngle(time,age,n,b,w=w))
        nproduce &(generator.CotyledonAngle(time,age,n,b,w=w))
        for w in range(0, generator.PetioleWMax()):
            nproduce Petiole(time,age,n,b) @Ge @Gc
        nproduce SetColor(generator.CotyledonColor(time,age,n,b,w=w))
        nproduce SetContour(generator.CotyledonProfile(time,age,n,b,w=w,x=0))
        length = generator.CotyledonLength(time,age,n,b,w=w)
        nproduce F(0.001 * length)
        xprev = 0.0
        for x in component.XIterator():
            DX = length * (x - xprev)
            xprev = x
            nproduce _(generator.CotyledonWidth(time,age,n,b,w=w,x=x))
            nproduce &(generator.CotyledonBend(time,age,n,b,w=w,x=x)*DX)
            nproduce /(generator.CotyledonTwist(time,age,n,b,w=w,x=x)*DX)
            nproduce SetContour(generator.CotyledonProfile(time,age,n,b,w=w,x=x))
            if x == 1:
                produce F(DX)
            else:
                nproduce F(DX)

