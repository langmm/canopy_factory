Bud(time,age,n,b,w):
    component = generator.parameters["Bud"]
    with component.temporary_index(time,age,n,b,w=w):
        if not component.CheckProduceComponent(time,age,n,b,w=w):
            produce [/(0)]
        if generator.verbose_lpy:
            print(f"Homomorphism Bud[{age},{n}]")
        age_mature = generator.BudAgeMature(time,age,n,b,w=w)
        if age >= age_mature:
            time = time + age_mature
            age = age - age_mature
            if generator.verbose_lpy:
                print(f"Replacing Bud[{age + age_mature},{n}] with Flower[{age},{n}]")
            produce Flower(time,age,n,b,w)
        nproduce /(generator.BudRotationAngle(time,age,n,b,w=w))
        nproduce &(generator.BudAngle(time,age,n,b,w=w))
        nproduce /(generator.BudTiltAngle(time,age,n,b,w=w))
        length = generator.BudLength(time,age,n,b,w=w)
        nproduce F(length)
        produce @O(length)

