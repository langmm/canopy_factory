        nproduce /(generator.FruitRotationAngle(time,age,n,b,w=w))
        nproduce &(generator.FruitAngle(time,age,n,b,w=w))
        for w in range(0, generator.PedicelWMax()):
            nproduce Pedicel(time,age,n,b)
        nproduce SetColor(generator.FruitColor(time,age,n,b,w=w))
        length = generator.FruitLength(time,age,n,b,w=w)
        nproduce F(length)
        produce @O(length)

