
############################################################
## External parameters
############################################################

extern(RUNTIME_PARAM = {})
extern(OUTPUT_TIME = 27)
extern(DERIVATION_LENGTH = OUTPUT_TIME)

############################################################
## Python functions
############################################################

from canopy_factory.utils import get_class_registry
generator_cls = get_class_registry().get("crop", "tomato")
generator = generator_cls(context=context(), **RUNTIME_PARAM)
NMax = generator.NMax()
PLASTOCHRON = generator.Plastocron()
StartingAngle = generator.sample_dist("uniform", 0, 360)
if generator.verbose_lpy:
    print(f"OUTPUT_TIME = {OUTPUT_TIME}")
    print(f"DERIVATION_LENGTH = {DERIVATION_LENGTH}")
    print(f"PLASTOCHRON = {PLASTOCHRON}")


############################################################
## Begin LSystem syntax
############################################################

module A
module Apex
module Internode
module Node
module Cotyledon
module Petiole
module Leaf
module Fruit
module Pedicel
module Branch

Axiom: @Gc/(StartingAngle)Apex(0,0,0,0)@Ge
derivation length: DERIVATION_LENGTH

production:

Apex(time,age,n,b):
    component = generator.parameters["Apex"]
    if not component.CheckProduceComponent(time,age,n,b):
        produce *
    if (time + age) >= OUTPUT_TIME:
        produce Apex(time,age,n,b)
    elif component.CheckProduceAge(time,age,n,b):
        if generator.verbose_lpy:
            print(f"Ageing Apex[{age},{n}]")
        ageinc = min(generator.AgeInc(),
                     OUTPUT_TIME - (time + age))
        produce Apex(time,age+ageinc,n,b)
    time = time + age
    if age >= PLASTOCHRON:
        age = age - PLASTOCHRON
    if generator.verbose_lpy:
        print(f"Node: {n} (t = {time})")
    nproduce /(generator.ApexRotationAngle(time,age,n,b))
    nproduce &(generator.ApexAngle(time,age,n,b))
    for w in range(0, generator.InternodeWMax()):
        nproduce Internode(time,age,n,b)
    nproduce [Node(time,age,n,b)]
    for b in range(0, generator.BranchBMax()):
        nproduce [Branch(time,age,n,b)]
    produce [/(0)]

Internode(time,age,n,b):
    component = generator.parameters["Internode"]
    if not component.CheckProduceComponent(time,age,n,b):
        produce *
    if (time + age) >= OUTPUT_TIME:
        produce Internode(time,age,n,b)
    else:
        if generator.verbose_lpy:
            print(f"Ageing Internode[{age},{n}]")
        ageinc = min(generator.AgeInc(),
                     OUTPUT_TIME - (time + age))
        produce Internode(time,age+ageinc,n,b)

Node(time,age,n,b):
    nproduce /(generator.NodeRotationAngle(time,age,n,b))
    nproduce &(generator.NodeAngle(time,age,n,b))
    for w in range(0, generator.CotyledonWMax()):
        nproduce [Cotyledon(time,age,n,b,w)]
    for w in range(0, generator.LeafWMax()):
        nproduce [Leaf(time,age,n,b,w)]
    for w in range(0, generator.FruitWMax()):
        nproduce [Fruit(time,age,n,b,w)]
    produce [/(0)]

Cotyledon(time,age,n,b,w):
    component = generator.parameters["Cotyledon"]
    if not component.CheckProduceComponent(time,age,n,b,w):
