
############################################################
## External parameters
############################################################

extern(RUNTIME_PARAM = {})
extern(OUTPUT_TIME = 27)
extern(DERIVATION_LENGTH = OUTPUT_TIME)

############################################################
## Python functions
############################################################

from canopy_factory.utils import get_class_registry
generator_cls = get_class_registry().get("crop", "monocot")
generator = generator_cls(context=context(), **RUNTIME_PARAM)
NMax = generator.NMax()
PLASTOCHRON = generator.Plastocron()
StartingAngle = generator.sample_dist("uniform", 0, 360)
if generator.verbose_lpy:
    print(f"OUTPUT_TIME = {OUTPUT_TIME}")
    print(f"DERIVATION_LENGTH = {DERIVATION_LENGTH}")
    print(f"PLASTOCHRON = {PLASTOCHRON}")


############################################################
## Begin LSystem syntax
############################################################

module A
module Apex
module Internode
module Node
module Leaf

Axiom: @Gc/(StartingAngle)Apex(0,0,0,0)@Ge
derivation length: DERIVATION_LENGTH

production:

Apex(time,age,n,b):
    component = generator.parameters["Apex"]
    if not component.CheckProduceComponent(time,age,n,b):
        produce *
    if (time + age) >= OUTPUT_TIME:
        produce Apex(time,age,n,b)
    elif component.CheckProduceAge(time,age,n,b):
        if generator.verbose_lpy:
            print(f"Ageing Apex[{age},{n}]")
        ageinc = min(generator.AgeInc(),
                     OUTPUT_TIME - (time + age))
        produce Apex(time,age+ageinc,n,b)
    plastochron = generator.ApexPlastocron()
    time = time + age
    if age >= plastochron:
        age = age - plastochron
    if generator.verbose_lpy:
        print(f"Node: {n} (t = {time})")
    nproduce /(generator.ApexRotationAngle(time,age,n,b))
    nproduce &(generator.ApexAngle(time,age,n,b))
    nproduce /(generator.ApexTiltAngle(time,age,n,b))
    nproduce Internode(time,age,n,b)
    nproduce [Node(time,age,n,b)]
    if generator.verbose_lpy:
        print(f"Next Apex: {n + 1}")
    for binc in range(0 + 1, generator.ApexBMax()):
        nproduce [Apex(time,age,n+1,b+binc)]
    binc = 0
    produce [Apex(time,age,n+1,b+binc)]

Internode(time,age,n,b):
    component = generator.parameters["Internode"]
    if not component.CheckProduceComponent(time,age,n,b):
        produce *
    if (time + age) >= OUTPUT_TIME:
        produce Internode(time,age,n,b)
    else:
        if generator.verbose_lpy:
            print(f"Ageing Internode[{age},{n}]")
        ageinc = min(generator.AgeInc(),
                     OUTPUT_TIME - (time + age))
        produce Internode(time,age+ageinc,n,b)

Node(time,age,n,b):
    nproduce /(generator.NodeRotationAngle(time,age,n,b))
    nproduce &(generator.NodeAngle(time,age,n,b))
    nproduce /(generator.NodeTiltAngle(time,age,n,b))
    for w in range(0, generator.LeafWMax()):
        nproduce [Leaf(time,age,n,b)]
    produce [/(0)]

Leaf(time,age,n,b):
    component = generator.parameters["Leaf"]
    if not component.CheckProduceComponent(time,age,n,b):
        produce *
    if (time + age) >= OUTPUT_TIME:
        produce Leaf(time,age,n,b)
    else:
        if generator.verbose_lpy:
            print(f"Ageing Leaf[{age},{n}]")
        ageinc = min(generator.AgeInc(),
                     OUTPUT_TIME - (time + age))
        produce Leaf(time,age+ageinc,n,b)

homomorphism:
maximum depth: 3

Apex(time,age,n,b):
    produce &(90)@o^(90)

Internode(time,age,n,b):
    component = generator.parameters["Internode"]
    with component.temporary_index(time,age,n,b):
        if not component.CheckProduceComponent(time,age,n,b):
            produce [/(0)]
        if generator.verbose_lpy:
            print(f"Homomorphism Internode[{age},{n}]")
        nproduce /(generator.InternodeRotationAngle(time,age,n,b))
        nproduce &(generator.InternodeAngle(time,age,n,b))
        nproduce /(generator.InternodeTiltAngle(time,age,n,b))
        nproduce SetColor(generator.InternodeColor(time,age,n,b))
        length = generator.InternodeLength(time,age,n,b)
        nproduce F(0.001 * length)
        xprev = 0.0
        for x in component.XIterator():
            DX = length * (x - xprev)
            xprev = x
            nproduce _(generator.InternodeWidth(time,age,n,b,x=x))
            nproduce &(generator.InternodeBend(time,age,n,b,x=x)*DX)
            nproduce /(generator.InternodeTwist(time,age,n,b,x=x)*DX)
            if x == 1:
                produce F(DX)
            else:
                nproduce F(DX)

Leaf(time,age,n,b):
    component = generator.parameters["Leaf"]
    with component.temporary_index(time,age,n,b):
        if not component.CheckProduceComponent(time,age,n,b):
            produce [/(0)]
        if generator.verbose_lpy:
            print(f"Homomorphism Leaf[{age},{n}]")
        nproduce /(generator.LeafRotationAngle(time,age,n,b))
        nproduce &(generator.LeafAngle(time,age,n,b))
        nproduce /(generator.LeafTiltAngle(time,age,n,b))
        nproduce SetColor(generator.LeafColor(time,age,n,b))
        nproduce SetContour(generator.LeafProfile(time,age,n,b,x=0))
        length = generator.LeafLength(time,age,n,b)
        nproduce F(0.001 * length)
        xprev = 0.0
        for x in component.XIterator():
            DX = length * (x - xprev)
            xprev = x
            nproduce _(generator.LeafWidth(time,age,n,b,x=x))
            nproduce &(generator.LeafBend(time,age,n,b,x=x)*DX)
            nproduce /(generator.LeafTwist(time,age,n,b,x=x)*DX)
            nproduce SetContour(generator.LeafProfile(time,age,n,b,x=x))
            if x == 1:
                produce F(DX)
            else:
                nproduce F(DX)

interpretation:

endlsystem
